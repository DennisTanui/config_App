<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- SOS BUTTON -->
    <Button
        android:id="@+id/buttonSOS"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:backgroundTint="#2196F3"
        android:text="SOS"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FIND SERVICES BUTTON -->
    <Button
        android:id="@+id/buttonFindServices"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="25dp"
        android:backgroundTint="#4CAF50"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="#FFFFFF"
        android:gravity="center"
        android:text="Find Services"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/buttonSOS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LOCATION BUTTON -->
    <Button
        android:id="@+id/buttonLocation"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#9C27B0"
        android:text="Location"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/buttonFindServices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonContact" />

    <!-- CONTACT BUTTON -->
    <Button
        android:id="@+id/buttonContact"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_marginTop="35dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#FF9800"
        android:text="Contact"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/buttonFindServices"
        app:layout_constraintStart_toEndOf="@id/buttonLocation"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TASKS BUTTON -->
    <Button
        android:id="@+id/buttonTasks"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#009688"
        android:text="Tasks"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/buttonLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonSettings" />

    <!-- SETTINGS BUTTON -->
    <Button
        android:id="@+id/buttonSettings"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="#607D8B"
        android:text="Settings"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/buttonContact"
        app:layout_constraintStart_toEndOf="@id/buttonTasks"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
